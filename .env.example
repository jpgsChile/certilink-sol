# Copiar a `.env` en la raíz del proyecto (Vite solo carga variables con prefijo VITE_)
# Tras cambiar .env: detén y vuelve a ejecutar `pnpm dev`.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativa (clave JWT “anon” del panel, legacy): si usas esta, no hace falta PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: habilita /diagnostico en builds que no sean dev (staging). En dev ya está activo.
# VITE_ENABLE_SUPABASE_DIAGNOSTICS=true

# Pinata (IPFS) — JWT con permisos pinFile + pinJSON. Debe ser UNA línea con tres segmentos: xxx.yyy.zzz
# Crear en https://app.pinata.cloud/developers/api-keys → New Key → copiar el JWT completo (incluye los dos puntos).
# VITE_PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySW5m...

# URL pública de la app (QR del diploma, metadata IPFS). En producción use su dominio Vercel.
# Obligatorio en build de producción si emite desde localhost; si no, el QR apunta a http://localhost:5173.
# VITE_PUBLIC_APP_BASE_URL=https://certilink-sol.vercel.app
