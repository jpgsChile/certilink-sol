# Copiar a `.env` en la raíz del proyecto (Vite solo carga variables con prefijo VITE_)
# Tras cambiar .env: detén y vuelve a ejecutar `pnpm dev`.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativa (clave JWT “anon” del panel, legacy): si usas esta, no hace falta PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: habilita /diagnostico en builds que no sean dev (staging). En dev ya está activo.
# VITE_ENABLE_SUPABASE_DIAGNOSTICS=true

# Pinata (IPFS) — JWT con permisos de pinFile. En producción preferir proxy servidor.
# VITE_PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL pública de la app para enlaces en metadata (opcional; si no se define, se usa el origen del navegador).
# VITE_PUBLIC_APP_BASE_URL=https://tu-dominio.cl
